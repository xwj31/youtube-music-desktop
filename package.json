{
  "name": "youtube-music-desktop",
  "version": "1.0.0",
  "description": "A simple YouTube Music desktop wrapper for macOS",
  "main": "src/main.js",
  "author": "Will",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run assets --silent && electron .",
    "assets": "node scripts/gen-assets.js",
    "pack": "npm run assets && electron-builder --dir",
    "dist": "npm run assets && electron-builder --mac"
  },
  "build": {
    "appId": "capital.hove.youtubemusic",
    "productName": "YouTube Music",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ]
    },
    "dmg": {
      "title": "YouTube Music"
    }
  },
  "devDependencies": {
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3"
  }
}
